{
    "compilerOptions": {
        "plugins": [],
        "checkJs": false,
        // Fully TS-compatible typing generation is not possible,
        // but turning off skipLibCheck can help debugging
        "skipLibCheck": true,
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "commonjs",
        "paths": {
            "@package": ["../../.probe/@package"],
            "@package/*": ["../../.probe/@package/*"],
            "@side-only/startup": ["../../.probe/@side-only/startup"],
            "@side-only/startup/*": ["../../.probe/@side-only/startup/*"],
            "@side-only/server": ["../../.probe/@side-only/server"],
            "@side-only/server/*": ["../../.probe/@side-only/server/*"],
            "@side-only/client": ["../../.probe/@side-only/client"],
            "@side-only/client/*": ["../../.probe/@side-only/client/*"],
            "@special": ["../../.probe/@special"],
            "@special/*": ["../../.probe/@special/*"]
        }
    },
    "typeAcquisition": {
        "enable": false
    },
    "include": [
        "./**/*.js",
        "./**/*.d.ts",
        "../../.probe/@package/**/*.d.ts",
        "../../.probe/@side-only/startup/**/*.d.ts",
        "../../.probe/@side-only/server/**/*.d.ts",
        "../../.probe/@side-only/client/**/*.d.ts",
        "../../.probe/@special/**/*.d.ts"
    ]
}
